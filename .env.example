# ============================================================
# Futbol Analiz Sistemi — mühit dəyişənləri
# Bu faylı .env adı ilə kopyalayın və dəyərləri doldurun.
# .env faylı HEÇ VAXT git-ə göndərilmir (.gitignore-dadır).
# ============================================================

# --- Məlumat mənbələri ---
# API-Football açarı: https://dashboard.api-football.com (pulsuz qeydiyyat)
FOOTBALL_API_KEY=
# football-data.org (pulsuz): https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=
# The Odds API (opsional, sonrakı mərhələ): https://the-odds-api.com
ODDS_API_KEY=

# --- LLM (sonrakı mərhələdə qoşulacaq) ---
LLM_ENABLED=false
# anthropic və ya openrouter
LLM_PROVIDER=anthropic
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
MODEL_NAME=claude-opus-5-5
LLM_LIGHT_MODEL=claude-haiku-4-5

# --- Telegram ---
# Token: Telegram-da @BotFather -> /newbot
# Chat ID: TELEGRAM_CHAT_ID boş olarkən sistemi işə salın və bota /start yazın —
# bot sizin chat ID-nizi göndərəcək.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Sistem ---
PAPER_MODE=true
TIMEZONE=Asia/Baku
DATABASE_URL=sqlite:///data/app.db
LOG_LEVEL=INFO
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Doldurulubsa, veb interfeys parol tələb edir (VPS-də mütləq doldurun)
DASHBOARD_PASSWORD=
DEFAULT_LANGUAGE=az

# --- config.yaml parametrlərini dəyişmək üçün (opsional) ---
# Boş qalsa, config.yaml-dakı dəyər işləyir.
STARTING_BANKROLL=
TARGET_BANKROLL=
MIN_ODDS=
MAX_ODDS=
MIN_CONFIDENCE=
MAX_DAILY_PICKS=
LINEUP_MONITORING=
